# Versiones de KrakenD con las que se compila, se prueba y se documenta el
# plugin A2A. Es el único lugar donde se fijan.
#
# Formato: CLAVE=valor, sin comillas ni espacios. Lo leen los scripts (a través
# de scripts/versions.sh), la integración continua y las pruebas de conformidad.
#
# Para probar otra versión sin tocar este fichero, define la variable al
# ejecutar:
#   KRAKEND_EE_VERSION=3.2.0 bash scripts/ci.sh
#
# Para adoptarla, cámbiala aquí y ejecuta "go test ./..." en config/conformance:
# la prueba lista cada fichero que aún nombra la versión anterior.
# El procedimiento completo está en docs/desarrollo.md.

# KrakenD Community. Imágenes krakend/builder y krakend.
KRAKEND_CE_VERSION=2.13.11

# KrakenD Enterprise. Imágenes krakend/builder-ee y krakend/krakend-ee.
KRAKEND_EE_VERSION=3.0.4

# Go del equipo que ejecuta la integración continua: formato, go vet y pruebas
# fuera de Docker. No decide con qué Go se compila el plugin: eso lo fija la
# imagen de compilación de cada versión de KrakenD.
CI_GO_VERSION=1.27.4
